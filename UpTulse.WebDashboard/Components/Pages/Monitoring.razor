@page "/"
@rendermode InteractiveServer

@using ItTechnologies.CoreUI.Areas.Enums
@using System.Net.ServerSentEvents
@using UpTulse.Application.Models
@using UpTulse.WebDashboard.EnvironmentVariables

@inject IJSRuntime JS
@implements IDisposable

<ItPageWidthLimiter>
    <div class="total-info-wrapper">
        <div class="card-info">
            <ItStateCard Title="Total" Value="@_total.ToString()" />
        </div>
        <div class="card-info">
            <ItStateCard Title="Up" Value="@_up.ToString()" IsActive="true"/>
        </div>
        <div class="card-info">
            <ItStateCard Title="Down" Value="@_down.ToString()" IsActive="false" />
        </div>
    </div>
    
    <ItSpacer Height="24" />
    <ItText Text="Targets" Style="ItTextStyle.Group"/>
    <ItSpacer Height="24"/>

    <div class="content">
           @foreach (var message in Messages
        .GroupBy(m => m.Name)
        .Select(g => g.OrderByDescending(x => x.EndTimeStamp).First())
        .OrderBy(m => m.Name))
    {
        <ItCard HeaderLeft="@message.EndTimeStamp.ToLocalTime().ToString("G")" HeaderRight="@(String.Concat(message.ResponseTimeMs.ToString(), " ms"))">
            <div class="wrapper">
                <div class="block bigger">
                    <ItStatus Status="@(message.IsUp? ItStatuses.Active : ItStatuses.Inactive)" />
                    <ItText Style="ItTextStyle.CardTitle" Text="@message.Name" />
                </div>
                <div class="block"></div>
            </div>
        </ItCard>
    }
    </div>
</ItPageWidthLimiter>

    @code {
    private List<MonitoringResult> Messages = new();
    private DotNetObjectReference<Monitoring>? objRef;

    private int _total;
    private int _up;
    private int _down;

    protected override async Task OnInitializedAsync()
    {
        objRef = DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync("sseHandlers.connect", objRef, Environment.GetEnvironmentVariable(SystemEnv.SERVER_URL) ?? string.Empty);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JS Error: {ex.Message}");
        }
    }

    private void CalculateStatistics()
    {

        var groupedMessages = Messages.GroupBy(m => m.Name);
        var firstFromGroup = groupedMessages
            .Select(g => g.OrderByDescending(x => x.EndTimeStamp)
            .First());

        _total = groupedMessages.Count();
        _up = firstFromGroup.Count(m => m.IsUp);
        _down = firstFromGroup.Count(m => !m.IsUp);
    }

    [JSInvokable]
    public async Task ReceiveMessage(string data)
    {
        if (!string.IsNullOrEmpty(data))
        {
            await InvokeAsync(() =>
            {
                var recievedRecord = System.Text.Json.JsonSerializer.Deserialize<MonitoringResult>(data);

                Messages = Messages.OrderBy(r => r.EndTimeStamp).ToList();

                if (Messages.Any(r => r.Name == recievedRecord?.Name) && Messages.Count(r => r.Name == recievedRecord?.Name) > 4)
                    Messages.RemoveAt(0);

                if (recievedRecord != null)
                {
                    Messages.Add(recievedRecord);
                }

                Messages = Messages.OrderByDescending(r => r.EndTimeStamp).ToList();
                CalculateStatistics();

                StateHasChanged();
            });
        }
    }

    public void Dispose() => objRef?.Dispose();
}